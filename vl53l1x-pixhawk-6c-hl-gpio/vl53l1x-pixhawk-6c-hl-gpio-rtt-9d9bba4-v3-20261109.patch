+#define PIN_SDA GPIO_STM32H7(GPIOD_PORT, 14) // FMU_CH5
+#define PIN_SCL GPIO_STM32H7(GPIOD_PORT, 15) // FMU_CH6
+
+void i2c_write(const gpio_port_pin_t scl, const gpio_port_pin_t sda,
+               uint8_t device_address, uint8_t *tx_buf, unsigned int tx_len);
+
+void i2c_read(const gpio_port_pin_t scl, const gpio_port_pin_t sda,
+              uint8_t device_address, uint8_t *rx_buf, unsigned int rx_len);
+
+void i2c_wr8(uint16_t addr, uint8_t data)
+{
+  uint8_t buf[3] = {};
+
+  buf[0] = addr >> 8;
+  buf[1] = addr & 0xff;
+  buf[2] = data;
+
+  i2c_write(PIN_SCL, PIN_SDA, 0x52, buf, sizeof(buf));
+}
+
+void i2c_rd(uint16_t addr, uint8_t *rx_buf, int rx_buf_len)
+{
+  uint8_t buf[2] = {};
+
+  buf[0] = addr >> 8;
+  buf[1] = addr & 0xff;
+
+  i2c_write(PIN_SCL, PIN_SDA, 0x52, buf, sizeof(buf));
+  i2c_read(PIN_SCL, PIN_SDA, 0x53, rx_buf, rx_buf_len);
+}
+
+typedef struct {
+  uint16_t addr;
+  uint8_t data;
+} i2c_access_t;
