+void i2c_access(i2c_access_t *seq)
+{
+  i2c_access_t *s;
+
+  for (s = seq; s && s->addr; s++) {
+    i2c_wr8(s->addr, s->data);
+  }
+}
+
+void i2c_lab(void)
+{
+  uint8_t data[4] = {};
+
+  gpio_set_value(PIN_SCL, 1);
+  gpio_set_value(PIN_SDA, 1);
+
+  /* Open-Drain, Enable On-Chip Pull-Ups */
+  gpio_set_mode_detail(PIN_SDA, GPIO_MODE_INPUT, /* as input use this mode */
+                       GPIO_MODE_DETAIL_STM32H7(0x00, 0x00, 0x00, 0x01));
+  gpio_set_mode_detail(PIN_SDA, GPIO_MODE_OUTPUT, /* as output use this mode */
+                       GPIO_MODE_DETAIL_STM32H7(0x01, 0x01, 0x00, 0x01));
+  gpio_set_mode_detail(PIN_SCL, GPIO_MODE_INPUT, /* as input use this mode */
+                       GPIO_MODE_DETAIL_STM32H7(0x00, 0x00, 0x00, 0x01));
+  gpio_set_mode_detail(PIN_SCL, GPIO_MODE_OUTPUT, /* as output use this mode */
+                       GPIO_MODE_DETAIL_STM32H7(0x01, 0x01, 0x00, 0x01));
+  gpio_set_direction(PIN_SCL, GPIO_DIR_OUTPUT);
+  gpio_set_direction(PIN_SDA, GPIO_DIR_OUTPUT);
+
+  i2c_rd(0x010f, &data[0], 2); // Model ID
+  if ((data[0] != 0xea) && (data[1] != 0xcc)) {
+    SEGGER_RTT_printf(0, "Model ID mismatch 0x%02x 0x%02x\n",
+		      data[0], data[1]);
+    return;
+  }
+  SEGGER_RTT_printf(0, "Detected Model with ID 0x%02x 0x%02x\n",
+		      data[0], data[1]);
+
+  SEGGER_RTT_printf(0, "Performing Soft Reset and will wait for Firmware\n");
+
+  i2c_wr8(0x0000, 0x00); // Soft Reset
+  silly_delay(100);
+  i2c_wr8(0x0000, 0x01); // Soft Reset
+
+  do {
+    data[0] = 0;
+    i2c_rd(0x00e5, &data[0], 1); // Firmware System Status
+    silly_delay(1);
+    if ((data[0] & 0x01) == 0) {
+      SEGGER_RTT_printf(0, "Waiting for Firmware\n");
+    }
+  }
+  while((data[0] & 0x01) == 0);
+
+  SEGGER_RTT_printf(0, "Sending setup sequence\n");
+
+  i2c_access(setup);
+  i2c_access(distance_mode_long);
+  i2c_access(measure_timing_budget);
+
+  {
+    uint16_t value;
+    i2c_rd(0x0022, &data[0], 2);
+
+    value = (data[0] << 8) | data[1];
+    value *= 4;
+    data[0] = value >> 8;
+    data[1] = value & 0xff;
+    
+    i2c_wr8(0x001e, data[0]);
+    i2c_wr8(0x001f, data[1]);
+  }
+  SEGGER_RTT_printf(0, "YYY\n");
+
+  i2c_rd(0x006c, &data[0], 4); // System Intermeasurement Period
+
+  SEGGER_RTT_printf(0, "ZZZ 0x%02x 0x%02x 0x%02x 0x%02x\n",
+		    data[0], data[1], data[2], data[3]);
+  
+  SEGGER_RTT_printf(0, "Done\n");
+}
