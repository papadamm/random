+#define PIN_SDA GPIO_STM32H7(GPIOD_PORT, 14) // FMU_CH5
+#define PIN_SCL GPIO_STM32H7(GPIOD_PORT, 15) // FMU_CH6
+
+void i2c_wr8(uint16_t addr, uint8_t data)
+{
+  uint8_t buf[3] = {};
+
+  buf[0] = addr >> 8;
+  buf[1] = addr & 0xff;
+  buf[2] = data;
+
+  i2c_write(PIN_SCL, PIN_SDA, 0x52, buf, sizeof(buf));
+}
+
+void i2c_wr16(uint16_t addr, uint16_t data)
+{
+  uint8_t buf[4] = {};
+
+  buf[0] = addr >> 8;
+  buf[1] = addr & 0xff;
+  buf[2] = data >> 8;
+  buf[3] = data & 0xff;
+
+  i2c_write(PIN_SCL, PIN_SDA, 0x52, buf, sizeof(buf));
+}
+
+void i2c_rdN(uint16_t addr, uint8_t *rx_buf, int rx_buf_len)
+{
+  uint8_t buf[2] = {};
+
+  buf[0] = addr >> 8;
+  buf[1] = addr & 0xff;
+
+  i2c_write(PIN_SCL, PIN_SDA, 0x52, buf, sizeof(buf));
+  i2c_read(PIN_SCL, PIN_SDA, 0x53, rx_buf, rx_buf_len);
+}
+
+uint8_t i2c_rd8(uint16_t addr)
+{
+  uint8_t data[1] = {};
+  
+  i2c_rdN(addr, &data[0], sizeof(data));
+
+  return data[0];
+}
+
+uint16_t i2c_rd16(uint16_t addr)
+{
+  uint8_t data[2] = {};
+  
+  i2c_rdN(addr, &data[0], sizeof(data));
+
+  return (data[0] << 8) | data[1];
+}
+
+void i2c_rd(uint16_t addr, uint8_t *rx_buf, int rx_buf_len)
+{
+  int k;
+
+  for (k = 0; k < rx_buf_len; k++) {
+    rx_buf[k] = i2c_rd8(addr + k);
+  }
+}
+
+typedef struct {
+  uint16_t addr;
+  uint8_t data;
+} i2c_access_t;
+
+void i2c_access(i2c_access_t *seq)
+{
+  i2c_access_t *s;
+
+  for (s = seq; s && s->addr; s++) {
+    i2c_wr8(s->addr, s->data);
+  }
+}
+
+i2c_access_t setup[] = { { 0x24, 0x0a }, { 0x25, 0x00 }, { 0x31, 0x02 },
