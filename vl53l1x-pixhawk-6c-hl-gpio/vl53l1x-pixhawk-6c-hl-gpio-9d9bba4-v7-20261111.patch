+
+uint32_t calc_macro_period(uint16_t vcsel_reg)
+{
+  uint32_t pll_period;
+  uint8_t vcsel_period;
+  uint32_t tmp;
+
+  pll_period = (1 << 30) / i2c_rd16(0x0006); // fast_osc;
+  vcsel_period = (i2c_rd16(vcsel_reg) + 1) << 1;
+  tmp = (pll_period * 2304) >> 6;
+  
+  return (tmp * vcsel_period) >> 6;
+}
+
+uint32_t us2mclk(uint16_t timeout_us, uint16_t macro_period_us)
+{
+  return ((timeout_us << 12) + (macro_period_us >> 1)) / macro_period_us;
+}
+
+uint16_t encode_timeout(uint32_t timeout_mclks)
+{
+  uint32_t ls_byte = 0;
+  uint16_t ms_byte = 0;
+
+  if (timeout_mclks > 0)
+  {
+    ls_byte = timeout_mclks - 1;
+
+    while ((ls_byte & 0xFFFFFF00) > 0)
+    {
+      ls_byte >>= 1;
+      ms_byte++;
+    }
+
+    return (ms_byte << 8) | (ls_byte & 0xFF);
+  }
+
+  return 0;
+}
+
+static void update_manual_spads(uint16_t peak_signal_count_rate,
+				uint16_t ambient_count_rate,
+				uint16_t spad_count,
+				uint16_t target_rate)
+{
+  uint16_t spads = 0x8000; // default mid-point
+  uint32_t tmp, rate_per_spad;
+  
+  if (spad_count) {
+    tmp = peak_signal_count_rate + ambient_count_rate;
+    if (tmp > 0xffff) {
+      tmp = 0xffff;
+    }
+    rate_per_spad = (tmp << 16) / spad_count;
+
+    if (rate_per_spad != 0) {
+      tmp = (target_rate << 16) / rate_per_spad;
+      if (tmp > 0xffff) {
+	tmp = 0xffff;
+      }
+      spads = tmp;
+    }
+  }
+  i2c_wr16(0x54, spads); // dss cfg manual effective spads select
+}
+
+static void set_roi_size(uint8_t width, uint8_t height)
+{
+  int w = width;
+  int h = height;
+
+  if (w > 16) { w = 16; }
+  if (h > 16) { h = 16; }
+
+  if (w > 10 || h > 10)
+  {
+    i2c_wr8(0x7f, 199); // ROI CFG centre spad
+  }
+
+  i2c_wr8(0x80, ((h - 1) << 4) | (w - 1)); // ROI CFG req global xy size
+}
+
+static int count_rate_scale(uint8_t hi, uint8_t lo)
+{
+  uint16_t n = (hi << 8) | lo;
+
+  return n >> 7;
+}
+
+static int count_rate(uint8_t hi, uint8_t lo)
+{
+  return (hi << 8) | lo;
+}
+
+static void setup_manual_calibration(void)
+{
+  uint8_t saved_vhv_cfg_init = i2c_rd8(0x0b);
+  uint8_t saved_vhv_cfg_timeout = i2c_rd8(0x08);
+
+  i2c_wr8(0x0b, saved_vhv_cfg_init & 0x7f);
+  i2c_wr8(0x08, (saved_vhv_cfg_timeout & 0x03) + (3 << 2));
+
+  i2c_wr8(0x4d, 0x01);
+  i2c_wr8(0x47, i2c_rd8(0xd8));
+}
+
+void i2c_lab(void)
+{
+  uint16_t osc_calibrated;
+  uint8_t data[4] = {};
+  int calibrated = 0;
+
+  gpio_set_value(PIN_SCL, 1);
+  gpio_set_value(PIN_SDA, 1);
+
+  /* Open-Drain, Enable On-Chip Pull-Ups */
+  gpio_set_mode_detail(PIN_SDA, GPIO_MODE_INPUT, /* as input use this mode */
+                       GPIO_MODE_DETAIL_STM32H7(0x00, 0x00, 0x00, 0x01));
+  gpio_set_mode_detail(PIN_SDA, GPIO_MODE_OUTPUT, /* as output use this mode */
+                       GPIO_MODE_DETAIL_STM32H7(0x01, 0x01, 0x00, 0x01));
+  gpio_set_mode_detail(PIN_SCL, GPIO_MODE_INPUT, /* as input use this mode */
+                       GPIO_MODE_DETAIL_STM32H7(0x00, 0x00, 0x00, 0x01));
+  gpio_set_mode_detail(PIN_SCL, GPIO_MODE_OUTPUT, /* as output use this mode */
+                       GPIO_MODE_DETAIL_STM32H7(0x01, 0x01, 0x00, 0x01));
+  gpio_set_direction(PIN_SCL, GPIO_DIR_OUTPUT);
+  gpio_set_direction(PIN_SDA, GPIO_DIR_OUTPUT);
+
+  i2c_rd(0x010f, &data[0], 2); // Model ID
+  if ((data[0] != 0xea) && (data[1] != 0xcc)) {
+    SEGGER_RTT_printf(0, "Model ID mismatch 0x%02x 0x%02x\n",
+		      data[0], data[1]);
+    return;
+  }
+  SEGGER_RTT_printf(0, "Detected Model with ID 0x%02x 0x%02x\n",
+		      data[0], data[1]);
+
+  SEGGER_RTT_printf(0, "Performing Soft Reset and will wait for Firmware\n");
+
+  // perform soft reset
+  i2c_wr8(0x0000, 0x00);
+  silly_delay(100);
+  i2c_wr8(0x0000, 0x01);
+
+  do {
+    data[0] = 0;
+    i2c_rd(0x00e5, &data[0], 1); // Firmware System Status
+    silly_delay(1);
+    if ((data[0] & 0x01) == 0) {
+      SEGGER_RTT_printf(0, "Waiting for Firmware\n");
+    }
+  }
+  while((data[0] & 0x01) == 0);
+
+  i2c_wr8(0x2e, i2c_rd8(0x2e) | 0x01); // select 2.8V mode
+  
+  i2c_rd(0x00de, &data[0], 2); // OSC calibrated value
+  osc_calibrated = (data[0] << 8) | data[1];
+  
+  SEGGER_RTT_printf(0, "Sending setup sequence\n");
+
+  i2c_access(setup);
+  i2c_access(distance_mode_long);
+
+  {
+    uint32_t range_config_timeout = (50000 - 4528) / 2;
+    uint32_t macro_period;
+    uint32_t phasecal_timeout;
+
+    // range cfg vcsel period a    
+    macro_period = calc_macro_period(0x60);
+
+    // phasecal cfg timeout macrop
+    phasecal_timeout = us2mclk(1000, macro_period);
+    if (phasecal_timeout > 0xff) {
+      phasecal_timeout = 0xff;
+    }
+    i2c_wr8(0x4b, phasecal_timeout);
+    
+    // mm cfg timeout macrop a
+    i2c_wr16(0x5a, encode_timeout(us2mclk(1, macro_period)));
+    // range cfg timeout macrop a
+    i2c_wr16(0x5e, encode_timeout(us2mclk(range_config_timeout, macro_period)));
+
+    // range cfg vcsel period b
+    macro_period = calc_macro_period(0x63);
+
+    // mm cfg timeout macrop b
+    i2c_wr16(0x5c, encode_timeout(us2mclk(1, macro_period)));
+    // range cfg timeout macrop b
+    i2c_wr16(0x61, encode_timeout(us2mclk(range_config_timeout, macro_period)));
+  }
+
+  i2c_wr16(0x1e, i2c_rd16(0x22) * 4);
+
+  {
+    uint32_t x = osc_calibrated * 50;
+    data[0] = (x >> 24) & 0xff;
+    data[1] = (x >> 16) & 0xff;
+    data[2] = (x >> 8) & 0xff;
+    data[3] = (x >> 0) & 0xff;
+  }
+  
+  i2c_wr8(0x006c, data[0]);
+  i2c_wr8(0x006d, data[1]);
+  i2c_wr8(0x006e, data[2]);
+  i2c_wr8(0x006f, data[3]);
+
+  set_roi_size(8, 16);
+
+  i2c_wr8(0x86, 0x01); // clear interrupts
+  i2c_wr8(0x87, 0x10); // start
+
+  do {
+    uint8_t tio_hv_status = 0xff;
+    int data_ready;
+
+    i2c_rd(0x0031, &tio_hv_status, sizeof(tio_hv_status)); // GPIO_TIO_HV status
+    data_ready = (tio_hv_status & 0x01) == 0x00;
+
+    if (data_ready) {
+      uint8_t buf[17];
+
+      memset(buf, 0, sizeof(buf));
+      i2c_rd(0x89, &buf[0], sizeof(buf)); // Read Result Range Status
+
+      SEGGER_RTT_printf(0, "data ready (%d) (%d) (%d) 0x%02x%02x\n",
+			count_rate(buf[3], buf[4]),
+			count_rate_scale(buf[7], buf[8]),
+			count_rate_scale(buf[15], buf[16]),
+			buf[13], buf[14]);
+
+      if (!calibrated) {
+	setup_manual_calibration();
+	calibrated++;
+      }
+
+      update_manual_spads(count_rate(buf[15], buf[16]),
+			  count_rate(buf[7], buf[8]),
+			  count_rate(buf[3], buf[4]),
+			  0x0a00);
+      
+      i2c_wr8(0x86, 0x01); // clear interrupts
+      i2c_wr8(0x87, 0x10); // start
+    }
+    silly_delay(100);
+  } while(1);
+  
+  SEGGER_RTT_printf(0, "Done\n");
+}
