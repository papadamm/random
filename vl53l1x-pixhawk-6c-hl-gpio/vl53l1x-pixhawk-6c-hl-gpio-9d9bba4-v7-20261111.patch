+			 { 0x50, 0x00 }, { 0x51, 0x00 },
+			 { 0x52, 0x00 }, { 0x53, 0x00 }, { 0x57, 0x38 },
+			 { 0x64, (360 >> 8) }, { 0x65, 360 & 0xff },
+			 { 0x66, (192 >> 8) }, { 0x67, 192 & 0xff },
+			 { 0x71, 0x01 }, { 0x7c, 0x01 }, { 0x7e, 0x02 },
+			 { 0x82, 0x00 }, { 0x77, 0x01 },
